awsProfilesWithWarning=(qa prod)

function join_by {
    local delimiter="$1"
    local result=""
	shift
	for part in "$@"
	do
        if [[ "$part" == "" ]]
        then
            continue
        fi

        if [[ "$result" == "" ]]
		then
			result="$part"
		else
			result="$result$delimiter$part"
		fi
	done
	echo "$result"
}

repositoryUrl=`git remote get-url origin 2> /dev/null`

if [[ "$repositoryUrl" == "" ]]
then
	repositoryUrl=`basename "$(git rev-parse --show-toplevel 2> /dev/null)"`
fi

repositoryPart=""
if [[ "$repositoryUrl" != "" ]]
then
	repositoryUrlBasename=`basename "$repositoryUrl"`
	repository=`echo "$repositoryUrlBasename" | sed -E 's/^(.+)\.git$/\1/'`

	if [[ "$repository" != "" ]]
	then

		branch="$(git branch --show-current 2>/dev/null)"

		nAheadText=
		nBehindText=
		divergedText=
		nAhead=$(git rev-list --count @{u}..HEAD 2>/dev/null)
		if [ "$?" == "0" ]
		then
			if [ "$nAhead" != "0" ]
			then
				nAheadText="\033[2;96m+$nAhead"
			fi

			nBehind=$(git rev-list --count HEAD..@{u} 2>/dev/null)
			if [ "$nBehind" != "0" ]
			then
				if [ "$nAhead" != "0" ]
				then
					# trees in local and remote have diverged (s.o. else force-pushed)
					# ±
					nDiverged=$(expr $nAhead + $nBehind)
					divergedText="\033[1;91m±$nDiverged"
					nAheadText=
				else
					nBehindText="\033[1;91m-$nBehind"
				fi
			fi
		fi
		repositoryPart="\033[1;34mΣ $repository ⑂ $branch$nAheadText$nBehindText$divergedText"
  	fi
fi

envWarning=""
for profileName in ${awsProfilesWithWarning[@]}
do
	if [[ "$AWS_PROFILE" =~ $profileName ]]
	then
		envWarning="\033[1;91m!${profileName^^}!"
		break
	fi
done

result=$(join_by "\033[0m " "$repositoryPart" "$envWarning")
if [[ "$result" != "" ]]
then
    # Σ ⑂
    printf "$result "
fi
